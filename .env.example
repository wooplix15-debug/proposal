# Wooplix Proposal Agent — environment file
# Copy this file to ".env" (same folder) and fill in your real values.
# NEVER commit or share the filled-in ".env". It holds live secrets.

# --- Required: the language model ---
GROQ_API_KEY=
# Optional. Leave blank to use the default. Confirm the model is available on
# your key with:  curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional: Zoho CRM precedent + WorkDrive upload ---
# Without these the agent still works; it just skips CRM precedent and upload.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# India data centre by default. Change if your Zoho account is in another DC.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Module the agent reads for past-proposal precedent.
ZOHO_CRM_MODULE=Deals
# WorkDrive folder id to upload finished files into ("root" = your root folder).
ZOHO_WORKDRIVE_FOLDER_ID=root

# Optional signing secret for the web analysis and answer flow.
# Use a long random server-side value. If blank, the server uses GROQ_API_KEY.
WORKFLOW_SIGNING_SECRET=

# Supabase public browser configuration (safe to expose with Row Level Security enabled).
# Set the same names in Vercel Project Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
